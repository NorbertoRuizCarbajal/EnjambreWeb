# Copia este archivo como .env SOLO para `netlify dev` en tu equipo. Nunca subas .env al repositorio.
# En producción define estas variables en Netlify → Site configuration → Environment variables (alcance: Functions).

# Obligatorias
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
RATE_LIMIT_SALT=cadena-aleatoria-larga

# Diagnóstico (/api/health). Déjala vacía en producción para deshabilitar el endpoint. Mínimo 16 caracteres.
HEALTH_TOKEN=

# Correo (opcional)
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

# Seguridad (opcional)
ALLOWED_ORIGIN=

# Capa de cuerpos de agua (opcional; por defecto SEMARNAT esdig/Agua, subcapas 6 y 7)
CONAGUA_LAYER_URL=
CONAGUA_LAYER_IDS=
WATER_SOURCE_NAME=
CONAGUA_CA_PEM=
